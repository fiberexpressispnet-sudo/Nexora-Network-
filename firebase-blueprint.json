{
  "entities": {
    "ispData": {
      "title": "ISP Workspace Data",
      "description": "Schema for workspace persistent collections and settings",
      "type": "object",
      "properties": {
        "value": {
          "type": "object",
          "description": "State payload"
        },
        "updatedAt": {
          "type": "number",
          "description": "Timestamp of update"
        }
      },
      "required": ["updatedAt"]
    },
    "userAppData": {
      "title": "User Application Data",
      "description": "User-specific settings and preferences",
      "type": "object",
      "properties": {
        "value": {
          "type": "object",
          "description": "User state data"
        },
        "updatedAt": {
          "type": "number",
          "description": "Timestamp of update"
        }
      },
      "required": ["updatedAt"]
    }
  },
  "firestore": {
    "/ispWorkspace/mainData/collections/{collectionKey}": {
      "schema": "ispData",
      "description": "Central ISP configuration and management collections"
    },
    "/users/{userId}/appData/{key}": {
      "schema": "userAppData",
      "description": "Individual user scoped app preferences"
    }
  }
}
